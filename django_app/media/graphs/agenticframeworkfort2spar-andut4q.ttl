ex:agenticframeworkfort2spar-andut4q-p2-8 a doc:Paragraph ;
    rdfs:label "Page 2 Paragraph 8" ;
    doc:bbox "54.0,568.6558227539062,292.50469970703125,704.4066772460938" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-4 ;
    doc:pageNumber 2 ;
    doc:paragraphOrder 8 ;
    doc:text "Problem Formulation Given a natural language question q, the task is to generate an executable SPARQL query s that retrieves a complete and semantically correct answer set A from a subset of a heterogeneous KG collection G = {G1, G2, . . . , Gn}. Each KG Gi ∈G consists of entities and relations represented as triples (h, r, t), where h and t are entities, and r is a relation type (Yih et al. 2015; Saxena, Tripathi, and Talukdar 2020). A valid SPARQL query s is expected to satisfy two properties. First, it must be executable, meaning it can be evaluated on at least one graph Gi ∈G without syntax or schema violations. Second, it must be semantically accurate, in that" ;
    dom:hasTopic <http://example.org/resource/topic/entities>,
        <http://example.org/resource/topic/executable>,
        <http://example.org/resource/topic/semantically>,
        <http://example.org/resource/topic/sparql>,
        <http://example.org/resource/topic/sparql%20query> ;
    dom:mentionsEntity <http://example.org/resource/entity/2015>,
        <http://example.org/resource/entity/First>,
        <http://example.org/resource/entity/G1>,
        <http://example.org/resource/entity/G2>,
        <http://example.org/resource/entity/KG>,
        <http://example.org/resource/entity/Problem%20Formulation%20Given>,
        <http://example.org/resource/entity/SPARQL>,
        <http://example.org/resource/entity/Saxena>,
        <http://example.org/resource/entity/Second>,
