ex:agenticframeworkfort2spar-andut4q-p5-11 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 11" ;
    doc:bbox "319.5001525878906,556.3117065429688,558.0048217773438,654.0372314453125" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 11 ;
    doc:text "Knowledge Graph Allocation. We evaluate the allocator’s effectiveness by measuring the proportion of subgoals routed to a graph that actually contains the gold answer. As shown in Figure 5, AGENTICT2S attains the highest allocation accuracy, exceeding the strongest baseline (DeepSeekR1) by over 10%. This precision directly impacts EA: correctly routed subgoals are more likely to match relevant schemas, leading to higher query validity and fewer empty results." ;
    dom:hasTopic <http://example.org/resource/topic/allocation>,
        <http://example.org/resource/topic/graph>,
        <http://example.org/resource/topic/higher%20query>,
        <http://example.org/resource/topic/routed>,
        <http://example.org/resource/topic/subgoals> ;
    dom:mentionsEntity <http://example.org/resource/entity/AGENTICT2S>,
        <http://example.org/resource/entity/EA>,
        <http://example.org/resource/entity/Knowledge%20Graph%20Allocation>,
        <http://example.org/resource/entity/over%2010%25>,
        <http://example.org/resource/entity/relevant%20schemas> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

ex:agenticframeworkfort2spar-andut4q-p5-12 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 12" ;
    doc:bbox "319.50018310546875,661.4757080078125,558.0047607421875,704.40625" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 12 ;
    doc:text "Cross-KG Robustness. Tables 2 and Table 3 present the EA and QSC scores per graph. AGENTICT2S consistently leads across all three graphs. On German-IS and EU-Pilot, gains are attributed to improved subgoal decomposition and" ;
    dom:hasTopic <http://example.org/resource/topic/consistently>,
        <http://example.org/resource/topic/consistently%20leads>,
        <http://example.org/resource/topic/ea%20qsc%20scores>,
        <http://example.org/resource/topic/improved%20subgoal>,
        <http://example.org/resource/topic/improved%20subgoal%20decomposition> ;
    dom:mentionsEntity <http://example.org/resource/entity/AGENTICT2S>,
        <http://example.org/resource/entity/Cross-KG%20Robustness>,
        <http://example.org/resource/entity/EA>,
        <http://example.org/resource/entity/EU->,
        <http://example.org/resource/entity/EU-Pilot>,
        <http://example.org/resource/entity/German>,
        <http://example.org/resource/entity/IS>,
        <http://example.org/resource/entity/KG>,
        <http://example.org/resource/entity/On%20German>,
        <http://example.org/resource/entity/QSC>,
        <http://example.org/resource/entity/three> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

ex:agenticframeworkfort2spar-andut4q-p5-13 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 13" ;
    doc:bbox "58.48298645019531,639.55810546875,292.5042419433594,704.4066772460938" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 13 ;
    doc:text "• Zero-Shot LLMs. Models prompted to generate SPARQL from natural language, without taskspecific fine-tuning. This includes LLaMA3-70B and LLaMA3.3-70B (Touvron et al. 2024), Qwen3-32b and QwQ-32b (Qwen Team 2024), DeepSeek-V3 (Liu et al. 2024), and GPT-4o (OpenAI 2024)." ;
    dom:hasTopic <http://example.org/resource/topic/et%20al>,
        <http://example.org/resource/topic/et%20al%20gpt->,
        <http://example.org/resource/topic/fine-tuning%20includes>,
        <http://example.org/resource/topic/includes%20touvron>,
        <http://example.org/resource/topic/includes%20touvron%20et> ;
    dom:mentionsEntity <http://example.org/resource/entity/2024>,
        <http://example.org/resource/entity/DeepSeek-V3>,
        <http://example.org/resource/entity/GPT->,
        <http://example.org/resource/entity/LLaMA3-70B>,
        <http://example.org/resource/entity/Liu%20et%20al>,
        <http://example.org/resource/entity/QwQ-32b>,
        <http://example.org/resource/entity/Qwen%20Team>,
        <http://example.org/resource/entity/Qwen%20Team%202024>,
        <http://example.org/resource/entity/Qwen3-32b>,
        <http://example.org/resource/entity/SPARQL>,
        <http://example.org/resource/entity/Touvron>,
        <http://example.org/resource/entity/V3> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

ex:agenticframeworkfort2spar-andut4q-p5-2 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 2" ;
    doc:bbox "323.98297119140625,56.316158294677734,558.00439453125,167.86062622070312" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 2 ;
    doc:text "• Reasoning-Augmented LLMs. The same models are evaluated with chain-of-thought s prompting (Wei et al. 2022) and self-ask prompting (Press et al. 2022) to elicit intermediate reasoning steps prior to query generation. • Agent Controllers. General-purpose multi-agent frameworks, including ReAct (Yao et al. 2023) and AutoGen (Wu et al. 2024b), are combined with LLaMA3 and Qwen3. These systems define planning and execution roles, but do not incorporate symbolic verification or schema-guided generation." ;
    dom:hasTopic <http://example.org/resource/topic/et%20al>,
        <http://example.org/resource/topic/generation>,
        <http://example.org/resource/topic/including%20react>,
        <http://example.org/resource/topic/including%20react%20yao>,
        <http://example.org/resource/topic/prompting> ;
    dom:mentionsEntity <http://example.org/resource/entity/2022>,
        <http://example.org/resource/entity/2023>,
        <http://example.org/resource/entity/2024b>,
        <http://example.org/resource/entity/Agent%20Controllers>,
        <http://example.org/resource/entity/AutoGen>,
        <http://example.org/resource/entity/LLaMA3>,
        <http://example.org/resource/entity/Qwen3>,
        <http://example.org/resource/entity/ReAct>,
        <http://example.org/resource/entity/Wei%20et%20al>,
        <http://example.org/resource/entity/Wu%20et%20al>,
        <http://example.org/resource/entity/Yao%20et%20al> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

ex:agenticframeworkfort2spar-andut4q-p5-3 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 3" ;
    doc:bbox "319.49993896484375,178.60459899902344,558.0046997070312,313.4775085449219" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 3 ;
    doc:text "Evaluation Metrics We evaluated model performance using four metrics: execution accuracy (EA), query syntax correctness (QSC), triplelevel F1 (TF1), and average token usage (ATU). EA measures whether the generated SPARQL query executes without error and returns an answer set that matches the gold standard. QSC reflects the proportion of syntactically valid queries based on Apache Jena parsing. TF1 computes microaveraged F1 over triple patterns in the WHERE clause, ignoring variable renaming and FILTER expressions. ATU reports the average number of tokens used per prediction as a proxy for generation efficiency." ;
    dom:hasTopic <http://example.org/resource/topic/atu>,
        <http://example.org/resource/topic/average>,
        <http://example.org/resource/topic/ignoring>,
        <http://example.org/resource/topic/metrics>,
        <http://example.org/resource/topic/qsc> ;
    dom:mentionsEntity <http://example.org/resource/entity/ATU>,
        <http://example.org/resource/entity/Apache%20Jena>,
        <http://example.org/resource/entity/EA>,
        <http://example.org/resource/entity/Evaluation%20Metrics%20We>,
        <http://example.org/resource/entity/F1>,
        <http://example.org/resource/entity/FILTER>,
        <http://example.org/resource/entity/QSC>,
        <http://example.org/resource/entity/SPARQL>,
        <http://example.org/resource/entity/TF1>,
        <http://example.org/resource/entity/WHERE>,
        <http://example.org/resource/entity/four> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

ex:agenticframeworkfort2spar-andut4q-p5-6 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 6" ;
    doc:bbox "53.99998474121094,378.6027526855469,292.5046691894531,424.7827453613281" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 6 ;
    doc:text "Datasets and Evaluation Settings We evaluated three RDF KGs related to industrial resource exchanges in the circular economy domain, all curated inhouse. Each KG differs in schema complexity and coverage." ;
    dom:hasTopic <http://example.org/resource/topic/circular%20economy%20domain>,
        <http://example.org/resource/topic/complexity%20coverage>,
        <http://example.org/resource/topic/domain%20curated>,
        <http://example.org/resource/topic/domain%20curated%20inhouse>,
        <http://example.org/resource/topic/economy%20domain> ;
    dom:mentionsEntity <http://example.org/resource/entity/Evaluation%20Settings%20We>,
        <http://example.org/resource/entity/KG>,
        <http://example.org/resource/entity/RDF>,
        <http://example.org/resource/entity/three> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

ex:agenticframeworkfort2spar-andut4q-p5-7 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 7" ;
    doc:bbox "319.50006103515625,422.69683837890625,558.0046997070312,476.5863342285156" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 7 ;
    doc:text "Token Efficiency. Despite using structured decoding and verification, AGENTICT2S remains efficient, averaging 875 tokens per example. This represents a 46.4% reduction in token usage compared to V-LLAMA3.3-70B (1632 tokens), while achieving higher performance across all metrics." ;
    dom:hasTopic <http://example.org/resource/topic/averaging>,
        <http://example.org/resource/topic/higher%20performance>,
        <http://example.org/resource/topic/higher%20performance%20metrics>,
        <http://example.org/resource/topic/token>,
        <http://example.org/resource/topic/tokens> ;
    dom:mentionsEntity <http://example.org/resource/entity/1632>,
        <http://example.org/resource/entity/46.4%25>,
        <http://example.org/resource/entity/875>,
        <http://example.org/resource/entity/AGENTICT2S>,
        <http://example.org/resource/entity/Token%20Efficiency>,
        <http://example.org/resource/entity/V-LLAMA3> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

ex:agenticframeworkfort2spar-andut4q-p5-9 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 9" ;
    doc:bbox "53.9999885559082,429.50518798828125,292.504638671875,600.8506469726562" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 9 ;
    doc:text "• German-IS. This dataset (8,649 triples) models 265 exchange cases from a national German program. Entities represent industrial actors and resources, annotated with multiple classification codes. • EU-Pilot. This dataset (11,810 triples) covers 305 cases from a European project. It includes structured metadata and is annotated with standardized waste classification codes. • Waste-Ledger. This dataset (52,402 triples) contains 1,727 instances of waste and resource flows across Europe, including quantitative attributes. The benchmark consists of 328 queries spanning both single-KG and cross-KG settings, curated from three circular economy knowledge graphs. The models are evaluated in three random seeds; we report mean ± standard deviation." ;
    dom:hasTopic <http://example.org/resource/topic/annotated>,
        <http://example.org/resource/topic/cases>,
        <http://example.org/resource/topic/dataset>,
        <http://example.org/resource/topic/dataset%20triples>,
        <http://example.org/resource/topic/triples> ;
    dom:mentionsEntity <http://example.org/resource/entity/1%2C727>,
        <http://example.org/resource/entity/11%2C810>,
        <http://example.org/resource/entity/265>,
        <http://example.org/resource/entity/305>,
        <http://example.org/resource/entity/328>,
        <http://example.org/resource/entity/52%2C402>,
        <http://example.org/resource/entity/8%2C649>,
        <http://example.org/resource/entity/EU->,
        <http://example.org/resource/entity/EU-Pilot>,
        <http://example.org/resource/entity/Europe>,
        <http://example.org/resource/entity/European>,
        <http://example.org/resource/entity/German>,
        <http://example.org/resource/entity/IS>,
        <http://example.org/resource/entity/KG>,
        <http://example.org/resource/entity/three> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

