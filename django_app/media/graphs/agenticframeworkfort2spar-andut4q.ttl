ex:agenticframeworkfort2spar-andut4q-p2-1 a doc:Paragraph ;
    rdfs:label "Page 2 Paragraph 1" ;
    doc:bbox "58.483001708984375,56.40748596191406,292.5045166015625,189.72396850585938" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-3 ;
    doc:pageNumber 2 ;
    doc:paragraphOrder 1 ;
    doc:text "• The framework incorporates three key components: (i) a weak-to-strong alignment allocator for schema-driven graph selection, (ii) a pattern-based SPARQL synthesizer with template scaffolding and post-hoc grammar repair, and (iii) a dual-stage verifier combining symbolic validation and counterfactual consistency checks. These are instantiated as five specialized agents with different roles. • Experimental results in three real-world circular economy KGs show that the proposed method improves execution accuracy by 17.3% and triple level F1 by 25.4% over the best baseline, while reducing the average prompt length by 46.4%." ;
    dom:hasTopic <http://example.org/resource/topic/components%20weak-to-strong>,
        <http://example.org/resource/topic/components%20weak-to-strong%20alignment>,
        <http://example.org/resource/topic/ii%20pattern-based>,
        <http://example.org/resource/topic/ii%20pattern-based%20sparql>,
        <http://example.org/resource/topic/iii> ;
    dom:mentionsEntity <http://example.org/resource/entity/17.3%25>,
        <http://example.org/resource/entity/25.4%25>,
        <http://example.org/resource/entity/46.4%25>,
        <http://example.org/resource/entity/F1>,
        <http://example.org/resource/entity/SPARQL>,
        <http://example.org/resource/entity/five>,
        <http://example.org/resource/entity/three> ;
    dom:statesClaim <http://example.org/resource/agenticframeworkfort2spar-andut4q-p2-1/claim/Result> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-2 .

ex:agenticframeworkfort2spar-andut4q-p2-3 a doc:Paragraph ;
    rdfs:label "Page 2 Paragraph 3" ;
    doc:bbox "319.49993896484375,269.8036193847656,558.0047607421875,467.4153137207031" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-4 ;
    doc:pageNumber 2 ;
    doc:paragraphOrder 3 ;
    doc:text "We present AGENTICT2S, a modular multi-agent framework to answer natural language questions on heterogeneous KGs. Unlike end-to-end GraphRAG pipelines (Han et al. 2024), which tightly link retrieval and generation in a single prompt-based step, AGENTICT2S separates the task into distinct components: subgoal decomposition, adaptive retrieval, query generation, verification, and answer aggregation. Each component is implemented as an independent agent with a clear input-output interface (Wu et al. 2025), allowing for parallelism, interpretability, and easier adaptation across domains. Given a question, the system first decomposes it into a sequence of subgoals. Each subgoal is then routed to a target KG selected based on schema compatibility and retrieval utility. Structured queries are generated under schema constraints and validated through a two-stage verification process. The resulting sub-answers are aggregated into a final response. The complete workflow is detailed in Algorithm 1." ;
    dom:hasTopic <http://example.org/resource/topic/answer>,
        <http://example.org/resource/topic/et%20al>,
        <http://example.org/resource/topic/retrieval>,
        <http://example.org/resource/topic/subgoal>,
        <http://example.org/resource/topic/verification> ;
    dom:mentionsEntity <http://example.org/resource/entity/2024>,
        <http://example.org/resource/entity/2025>,
        <http://example.org/resource/entity/AGENTICT2S>,
        <http://example.org/resource/entity/Algorithm%201>,
        <http://example.org/resource/entity/GraphRAG>,
        <http://example.org/resource/entity/Han>,
        <http://example.org/resource/entity/KG>,
        <http://example.org/resource/entity/Wu%20et%20al>,
        <http://example.org/resource/entity/first>,
        <http://example.org/resource/entity/two> ;
    dom:statesClaim <http://example.org/resource/agenticframeworkfort2spar-andut4q-p2-3/claim/ResearchObjective> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-2 .

ex:agenticframeworkfort2spar-andut4q-p4-5 a doc:Paragraph ;
    rdfs:label "Page 4 Paragraph 5" ;
    doc:bbox "319.5,256.1990051269531,558.0049438476562,500.1637878417969" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 4 ;
    doc:paragraphOrder 5 ;
    doc:text "Dual-Stage Consistency Checker Agent To safeguard against execution errors and underspecified queries, the Consistency Checker Agent (Algorithm 1, line 6) applies a two-stage verification process prior to query execution. This agent functions as a quality control layer that filters out syntactically invalid or semantically ambiguous queries before they reach the execution stage. In the first stage, symbolic validation is applied to assess syntactic correctness, predicate usage, and type compatibility with the schema of the target KG. The agent also performs a preliminary execution check to ensure that the query yields a non-empty result under current graph conditions. In the second stage, counterfactual testing is used to evaluate the semantic specificity. The agent systematically perturbs the selected query components, such as entities, filters, or predicates, and compares the result sets. Queries that produce unchanged outputs across such perturbations are flagged as overly general or underspecified. Only queries that pass both checks are forwarded for execution; others are revised or discarded. This mechanism improves the reliability of the final result by enforcing both structural validity and semantic precision." ;
    dom:hasTopic <http://example.org/resource/topic/agent>,
        <http://example.org/resource/topic/execution>,
        <http://example.org/resource/topic/queries>,
        <http://example.org/resource/topic/result>,
        <http://example.org/resource/topic/stage> ;
    dom:mentionsEntity <http://example.org/resource/entity/Algorithm%201>,
        <http://example.org/resource/entity/Consistency%20Checker%20Agent>,
        <http://example.org/resource/entity/KG>,
        <http://example.org/resource/entity/Stage%20Consistency%20Checker%20Agent%20To>,
        <http://example.org/resource/entity/first>,
        <http://example.org/resource/entity/second>,
        <http://example.org/resource/entity/two> ;
    dom:statesClaim <http://example.org/resource/agenticframeworkfort2spar-andut4q-p4-5/claim/Result> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-4 .

ex:agenticframeworkfort2spar-andut4q-p5-4 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 4" ;
    doc:bbox "53.99998474121094,121.11711883544922,292.50506591796875,368.8797912597656" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 4 ;
    doc:text "Experiments Experimental Setup We evaluate AGENTICT2S and all baselines on a standardized text-to-SPARQL generation task, where each system receives a natural language question and generates a SPARQL query, which is executed against the relevant KGs. AGENTICT2S runs in a hybrid setup that combines local model inference with API-based access to LLMs. The system is implemented using the LangGraph framework (LangGraph Contributors 2024), which supports agent coordination, intermediate state tracking, and structured execution flow. Local components include lightweight models for schema retrieval, subgoal parsing, and triple pattern scoring, executed on a workstation with four NVIDIA RTX 4090 Ti GPU. For language generation tasks that require larger context and structured decoding, we use LLaMA3-70B and LLaMA3.3-70B (Touvron et al. 2024), Qwen3-32b and QwQ-32b (Qwen Team 2024) via Groq API (Groq, Inc. 2024). The remaining models are accessed via their official APIs. All models are evaluated in zero-shot mode with a fixed temperature of 0.7 and no task-specific fine-tuning." ;
    dom:hasTopic <http://example.org/resource/topic/executed>,
        <http://example.org/resource/topic/groq>,
        <http://example.org/resource/topic/langgraph>,
        <http://example.org/resource/topic/models>,
        <http://example.org/resource/topic/setup> ;
    dom:mentionsEntity <http://example.org/resource/entity/0.7>,
        <http://example.org/resource/entity/2024>,
        <http://example.org/resource/entity/AGENTICT2S>,
        <http://example.org/resource/entity/API>,
        <http://example.org/resource/entity/API->,
        <http://example.org/resource/entity/Experiments%20Experimental%20Setup>,
        <http://example.org/resource/entity/Experiments%20Experimental%20Setup%20We>,
        <http://example.org/resource/entity/GPU>,
        <http://example.org/resource/entity/Groq%20API>,
        <http://example.org/resource/entity/Groq%2C%20Inc.>,
        <http://example.org/resource/entity/LangGraph>,
        <http://example.org/resource/entity/LangGraph%20Contributors%202024>,
        <http://example.org/resource/entity/NVIDIA>,
        <http://example.org/resource/entity/QwQ-32b>,
        <http://example.org/resource/entity/Qwen%20Team>,
        <http://example.org/resource/entity/Qwen3-32b>,
        <http://example.org/resource/entity/RTX>,
        <http://example.org/resource/entity/SPARQL>,
        <http://example.org/resource/entity/Touvron>,
        <http://example.org/resource/entity/four>,
        <http://example.org/resource/entity/zero> ;
    dom:statesClaim <http://example.org/resource/agenticframeworkfort2spar-andut4q-p5-4/claim/Method> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

ex:agenticframeworkfort2spar-andut4q-p5-5 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 5" ;
    doc:bbox "319.49993896484375,324.2214660644531,558.004638671875,415.2583923339844" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 5 ;
    doc:text "Main Results Table 1 reports the performance of all baselines and agent-based systems across EA, QSC, TF1, and ATU. AGENTICT2S outperforms all models, achieving 72.43% EA, 76.21% QSC, and 83.68% TF1. These correspond to relative gains of 17.3% in EA and 25.4% in TF1 over the strongest LLM baseline, V-L-GPT-4O, which reaches 55.15% EA and 58.32% TF1." ;
    dom:hasTopic <http://example.org/resource/topic/ea%20qsc>,
        <http://example.org/resource/topic/ea%20qsc%20atu>,
        <http://example.org/resource/topic/ea%20qsc%20correspond>,
        <http://example.org/resource/topic/ea%20strongest>,
        <http://example.org/resource/topic/qsc> ;
    dom:mentionsEntity <http://example.org/resource/entity/17.3%25>,
        <http://example.org/resource/entity/25.4%25>,
        <http://example.org/resource/entity/55.15%25>,
        <http://example.org/resource/entity/58.32%25>,
        <http://example.org/resource/entity/72.43%25>,
        <http://example.org/resource/entity/76.21%25>,
        <http://example.org/resource/entity/83.68%25>,
        <http://example.org/resource/entity/AGENTICT2S>,
        <http://example.org/resource/entity/ATU>,
        <http://example.org/resource/entity/EA>,
        <http://example.org/resource/entity/LLM>,
        <http://example.org/resource/entity/Main%20Results%20Table>,
        <http://example.org/resource/entity/QSC>,
        <http://example.org/resource/entity/TF1>,
        <http://example.org/resource/entity/V-L-GPT-4O> ;
    dom:statesClaim <http://example.org/resource/agenticframeworkfort2spar-andut4q-p5-5/claim/Result> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

ex:agenticframeworkfort2spar-andut4q-p5-8 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 8" ;
    doc:bbox "319.5001220703125,484.0247802734375,558.0046997070312,548.8732299804688" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-56 ;
    doc:pageNumber 5 ;
    doc:paragraphOrder 8 ;
    doc:text "Comparison to Reasoning-Augmented LLMs. Among chain-of-thought–based baselines, R-L-DEEPSEEK-R1 achieves the best results (50.32% EA, 52.18% TF1) but remains 22% behind our framework in EA. This highlights the limitations of prompting alone in capturing structural and semantic constraints across KGs." ;
    dom:hasTopic <http://example.org/resource/topic/ea%20highlights>,
        <http://example.org/resource/topic/ea%20highlights%20limitations>,
        <http://example.org/resource/topic/highlights>,
        <http://example.org/resource/topic/highlights%20limitations>,
        <http://example.org/resource/topic/highlights%20limitations%20prompting> ;
    dom:mentionsEntity <http://example.org/resource/entity/22%25>,
        <http://example.org/resource/entity/50.32%25>,
        <http://example.org/resource/entity/52.18%25>,
        <http://example.org/resource/entity/EA>,
        <http://example.org/resource/entity/R-L-DEEPSEEK-R1>,
        <http://example.org/resource/entity/Reasoning-Augmented>,
        <http://example.org/resource/entity/TF1> ;
    dom:statesClaim <http://example.org/resource/agenticframeworkfort2spar-andut4q-p5-8/claim/Result> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-5 .

