ex:agenticframeworkfort2spar-andut4q-p6-13 a doc:Paragraph ;
    rdfs:label "Page 6 Paragraph 13" ;
    doc:bbox "323.9830017089844,518.021484375,558.0047607421875,611.9840698242188" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-63 ;
    doc:pageNumber 6 ;
    doc:paragraphOrder 13 ;
    doc:text "• w/o Decomposer. Disables subgoal parsing; the full question is passed directly to the SPARQL generator. • w/o Allocator. Replaces graph selection with BM25 retrieval over the full KG pool. • w/o Synthesizer. Skips query generation; retrieved schema triples are returned as pseudoanswers. • w/o Verifier. Executes SPARQL queries without symbolic or counterfactual validation." ;
    dom:hasTopic <http://example.org/resource/topic/counterfactual%20validation>,
        <http://example.org/resource/topic/decomposer%20disables>,
        <http://example.org/resource/topic/executes%20sparql>,
        <http://example.org/resource/topic/executes%20sparql%20queries>,
        <http://example.org/resource/topic/sparql> ;
    dom:mentionsEntity <http://example.org/resource/entity/BM25>,
        <http://example.org/resource/entity/Decomposer>,
        <http://example.org/resource/entity/KG>,
        <http://example.org/resource/entity/SPARQL>,
        <http://example.org/resource/entity/Synthesizer>,
        <http://example.org/resource/entity/Verifier> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-6 .

ex:agenticframeworkfort2spar-andut4q-p6-14 a doc:Paragraph ;
    rdfs:label "Page 6 Paragraph 14" ;
    doc:bbox "54.0,566.5664672851562,292.504638671875,653.97802734375" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-63 ;
    doc:pageNumber 6 ;
    doc:paragraphOrder 14 ;
    doc:text "schema grounding, which enhance EA. On Waste-Ledger, which includes quantitative predicates and deeper ontologies, QSC gains reflect the effect of post-hoc decoding and structural validation. These results suggest that modular reasoning and symbolic validation, particularly subgoal decomposition and verification, are critical to scaling text-to-SPARQL to diverse and schema-rich KGs." ;
    dom:hasTopic <http://example.org/resource/topic/diverse%20schema-rich>,
        <http://example.org/resource/topic/diverse%20schema-rich%20kgs>,
        <http://example.org/resource/topic/includes%20quantitative>,
        <http://example.org/resource/topic/includes%20quantitative%20predicates>,
        <http://example.org/resource/topic/validation> ;
    dom:mentionsEntity <http://example.org/resource/entity/EA>,
        <http://example.org/resource/entity/On%20Waste>,
        <http://example.org/resource/entity/QSC>,
        <http://example.org/resource/entity/SPARQL> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-6 .

ex:agenticframeworkfort2spar-andut4q-p6-15 a doc:Paragraph ;
    rdfs:label "Page 6 Paragraph 15" ;
    doc:bbox "319.4999694824219,617.732421875,558.0049438476562,704.4070434570312" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-65 ;
    doc:pageNumber 6 ;
    doc:paragraphOrder 15 ;
    doc:text "All variants are evaluated on three random seeds, and the results are reported as mean ± standard deviation. As shown in Table 4, removing the subgoal decomposer leads to a sharp drop in EA from 72.4% to 23.7%, underscoring the importance of compositional parsing. Disabling the allocator similarly reduces performance, reflecting the impact of semantic drift when retrieval is not schema-aware. Omitting the verifier results in a 17% decline in EA, indicat-" ;
    dom:hasTopic <http://example.org/resource/topic/compositional%20parsing>,
        <http://example.org/resource/topic/impact>,
        <http://example.org/resource/topic/impact%20semantic>,
        <http://example.org/resource/topic/impact%20semantic%20drift>,
        <http://example.org/resource/topic/results> ;
    dom:mentionsEntity <http://example.org/resource/entity/17%25>,
        <http://example.org/resource/entity/23.7%25>,
        <http://example.org/resource/entity/72.4%25>,
        <http://example.org/resource/entity/EA>,
