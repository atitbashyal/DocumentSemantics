ex:agenticframeworkfort2spar-andut4q-p6-12 a doc:Paragraph ;
    rdfs:label "Page 6 Paragraph 12" ;
    doc:bbox "60.51661682128906,531.3983154296875,284.3785095214844,540.0811767578125" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-63 ;
