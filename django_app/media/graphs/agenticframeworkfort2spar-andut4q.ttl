ex:agenticframeworkfort2spar-andut4q-p4-4 a doc:Paragraph ;
    rdfs:label "Page 4 Paragraph 4" ;
    doc:bbox "54.0,254.34547424316406,292.5046081542969,275.2670593261719" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-55 ;
