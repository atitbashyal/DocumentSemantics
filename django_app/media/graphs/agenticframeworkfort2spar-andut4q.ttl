ex:agenticframeworkfort2spar-andut4q-p3-4 a doc:Paragraph ;
    rdfs:label "Page 3 Paragraph 4" ;
    doc:bbox "319.5,376.0994567871094,558.0050048828125,451.8160095214844" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-30 ;
    doc:pageNumber 3 ;
    doc:paragraphOrder 4 ;
    doc:text "prompt the user for clarification to ensure subgoal completeness and correctness. This approach does not require task-specific training data and is generalized across heterogeneous KGs. By decomposing complex queries into semantically independent components, the parser simplifies the reasoning process and enhances coordination among downstream agents." ;
    dom:hasTopic <http://example.org/resource/topic/components%20parser>,
        <http://example.org/resource/topic/components%20parser%20simplifies>,
        <http://example.org/resource/topic/does>,
        <http://example.org/resource/topic/does%20require>,
        <http://example.org/resource/topic/heterogeneous%20kgs%20decomposing> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-3 .

ex:agenticframeworkfort2spar-andut4q-p3-5 a doc:Paragraph ;
    rdfs:label "Page 3 Paragraph 5" ;
    doc:bbox "319.5,461.2669677734375,558.0050659179688,704.4069213867188" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-37 ;
    doc:pageNumber 3 ;
    doc:paragraphOrder 5 ;
    doc:text "Hierarchical Alignment Allocator Agent Each subgoal is assigned to a relevant KG by the Hierarchical Alignment Allocator Agent (Algorithm 1, line4), which selects candidate graphs through a two-stage retrieval process: coarse-grained filtering and fine-grained schema alignment based on the subgoal’s intent and constraints (Figure3). In the weak retrieval stage, the allocator conducts a vector similarity search over embedded metadata, including schema summaries and domain labels, to identify a subset of candidate KGs. For each selected graph, a secondary search is conducted over its internal source files, such as ontology documents and schema descriptions, to locate relevant terms associated with the subgoal. In the strong retrieval stage, schema-level alignment is performed on the top-ranked candidates. This step extracts predicates, class hierarchies, and domain-range constraints to assess whether the graph’s structure is compatible with the subgoal. The KG pool and metadata index support incremental updates, allowing the system to incorporate new resources without reprocessing. As additional KGs and metadata become available, the allocator adjusts its retrieval strategy to maintain schema alignment. Retrieval decisions are further" ;
    dom:hasTopic <http://example.org/resource/topic/alignment>,
        <http://example.org/resource/topic/allocator>,
        <http://example.org/resource/topic/metadata>,
        <http://example.org/resource/topic/retrieval>,
        <http://example.org/resource/topic/subgoal> ;
    dom:mentionsEntity <http://example.org/resource/entity/Algorithm%201%2C%20line4>,
        <http://example.org/resource/entity/Hierarchical%20Alignment%20Allocator%20Agent>,
        <http://example.org/resource/entity/Hierarchical%20Alignment%20Allocator%20Agent%20Each>,
        <http://example.org/resource/entity/KG>,
        <http://example.org/resource/entity/two> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-3 .

ex:agenticframeworkfort2spar-andut4q-p3-6 a doc:Paragraph ;
    rdfs:label "Page 3 Paragraph 6" ;
    doc:bbox "53.99999237060547,573.8055419921875,292.5046691894531,704.4070434570312" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-37 ;
    doc:pageNumber 3 ;
    doc:paragraphOrder 6 ;
    doc:text "The Compositional Subgoal Parser Agent initiates the AGENTICT2S pipeline (Algorithm 1, line 1) by decomposing a natural language question into a sequence of subgoals, each corresponding to a basic reasoning operation such as entity retrieval, condition filtering, or aggregation (Figure 2). The parser employs a rule-based strategy that combines shallow syntactic analysis with domain-specific heuristics. Structured prompts are used to guide a language model in identifying syntactic patterns, segmenting the question into subgoals, and assigning intent labels based on linguistic structure. The agent also includes mechanisms to detect ambiguity or underspecified semantics; when triggered, these" ;
    dom:hasTopic <http://example.org/resource/topic/agent>,
        <http://example.org/resource/topic/language>,
        <http://example.org/resource/topic/parser>,
        <http://example.org/resource/topic/subgoals>,
        <http://example.org/resource/topic/syntactic> ;
    dom:mentionsEntity <http://example.org/resource/entity/AGENTICT2S>,
        <http://example.org/resource/entity/Algorithm%201>,
        <http://example.org/resource/entity/The%20Compositional%20Subgoal%20Parser>,
        <http://example.org/resource/entity/The%20Compositional%20Subgoal%20Parser%20Agent> ;
    prov:wasDerivedFrom ex:agenticframeworkfort2spar-andut4q-page-3 .

