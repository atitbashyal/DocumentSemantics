ex:agenticframeworkfort2spar-andut4q-p2-7 a doc:Paragraph ;
    rdfs:label "Page 2 Paragraph 7" ;
    doc:bbox "319.9959716796875,544.4637451171875,545.4164428710938,686.2020874023438" ;
    doc:inSection ex:agenticframeworkfort2spar-andut4q-section-4 ;
    doc:pageNumber 2 ;
    doc:paragraphOrder 7 ;
    doc:text "1: g1, g2, . . . , gk ←SUBGOAL PARSER(q) 2: for each subgoal gi do 3: Ri ←CANDIDATE RETRIEVERS(gi, G) 4: Gi ←HIERARCHICAL ALLOCATOR(gi, Ri) 5: qi ←SPARQL SYNTHESIZER(gi, Gi) 6: if VERIFIER(qi, Gi) passes then 7: Ai ←EXECUTE QUERY(qi, Gi) 8: else 9: Ai ←FALLBACK OR SKIP(gi) 10: end if 11: end for 12: A ←CONSENSUS AGGREGATOR(A1, A2, . . . , Ak) 13: return A" ;
