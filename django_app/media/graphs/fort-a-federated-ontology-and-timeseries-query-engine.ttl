ex:fort-a-federated-ontology-and-timeseries-query-engine-p1-2 a doc:Paragraph ;
    rdfs:label "Page 1 Paragraph 2" ;
    doc:bbox "225.06533813476562,182.72889709472656,391.1073913574219,192.63182067871094" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-4 ;
