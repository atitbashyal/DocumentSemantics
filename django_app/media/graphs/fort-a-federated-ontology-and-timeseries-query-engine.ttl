ex:fort-a-federated-ontology-and-timeseries-query-engine-p3-13 a doc:Paragraph ;
    rdfs:label "Page 3 Paragraph 13" ;
    doc:bbox "70.42440032958984,583.78515625,284.80328369140625,593.25" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-10 ;
    doc:pageNumber 3 ;
    doc:paragraphOrder 13 ;
    doc:text "Listing 1: An Example of a SPARQL Federated Query" ;
    dom:hasTopic <http://example.org/resource/topic/example>,
        <http://example.org/resource/topic/example%20sparql>,
        <http://example.org/resource/topic/example%20sparql%20federated>,
        <http://example.org/resource/topic/sparql%20federated>,
