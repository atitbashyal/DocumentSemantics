ex:fort-a-federated-ontology-and-timeseries-query-engine-p6-16 a doc:Paragraph ;
    rdfs:label "Page 6 Paragraph 16" ;
    doc:bbox "62.130096435546875,555.0889282226562,189.33587646484375,569.2869873046875" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-19 ;
    doc:pageNumber 6 ;
    doc:paragraphOrder 16 ;
