    doc:paragraphOrder 12 ;
    doc:text "tenantid=BOC-XSD&db=mssql>{ 19 SELECT ?id ?time_Stamp ?temperature 20 WHERE { 21 ?id qt:hasTimeStamp ?time_Stamp. 22 ?id qt:hasValue ?temperature. 23 FILTER(?time_Stamp>’2015-10-08’ && ?temperature<0)} 24 } 25 FILTER (?timeSeriesId = ?id)}" ;
