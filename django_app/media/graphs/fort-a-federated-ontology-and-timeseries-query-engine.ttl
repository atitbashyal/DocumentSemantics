    dom:mentionsEntity <http://example.org/resource/entity/An%20Example>,
        <http://example.org/resource/entity/Federated%20Query>,
        <http://example.org/resource/entity/SPARQL> ;
    prov:wasDerivedFrom ex:fort-a-federated-ontology-and-timeseries-query-engine-page-3 .

ex:fort-a-federated-ontology-and-timeseries-query-engine-p3-14 a doc:Paragraph ;
    rdfs:label "Page 3 Paragraph 14" ;
    doc:bbox "58.356712341308594,606.131591796875,296.8710632324219,706.4590454101562" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-10 ;
    doc:pageNumber 3 ;
    doc:paragraphOrder 14 ;
    doc:text "The multiple queries (Q1, Q2, Q3) example of Fig. 3, aiming to detect malfunctioning temperature sensors on ﬂoor 2, can be written as shown in Listing 1. The SPARQL federated query consists of two sub-queries (Q1) lines 2-17 and (Q2) lines 18-24. The ﬁrst sub-query (Q1) will be forwarded to the remote SPARQL service endpoint with reasoning feature enabled as depicted in line 2 of Listing 1. This query requests all temperature sensors with Celsius unit located on L2. The inference will be applied on the location, the server types," ;
    dom:hasTopic <http://example.org/resource/topic/lines>,
        <http://example.org/resource/topic/listing>,
        <http://example.org/resource/topic/sensors>,
        <http://example.org/resource/topic/temperature>,
        <http://example.org/resource/topic/temperature%20sensors> ;
    dom:mentionsEntity <http://example.org/resource/entity/18>,
        <http://example.org/resource/entity/Fig>,
        <http://example.org/resource/entity/L2>,
        <http://example.org/resource/entity/Listing%201>,
        <http://example.org/resource/entity/Q1>,
        <http://example.org/resource/entity/Q2>,
        <http://example.org/resource/entity/Q3>,
        <http://example.org/resource/entity/SPARQL>,
        <http://example.org/resource/entity/two> ;
    prov:wasDerivedFrom ex:fort-a-federated-ontology-and-timeseries-query-engine-page-3 .

ex:fort-a-federated-ontology-and-timeseries-query-engine-p3-15 a doc:Paragraph ;
    rdfs:label "Page 3 Paragraph 15" ;
    doc:bbox "314.3778076171875,661.262451171875,552.8922729492188,706.8640747070312" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-10 ;
    doc:pageNumber 3 ;
    doc:paragraphOrder 15 ;
    doc:text "With SPARQL as its supported query language, FOrT´E, as shown in Fig. 4, is a query processor which handles a federated SPARQL query from an application, such as Listing 1. It is designed to recognize sub-queries to be executed on remote" ;
    dom:hasTopic <http://example.org/resource/topic/fig%20query>,
        <http://example.org/resource/topic/fig%20query%20processor>,
        <http://example.org/resource/topic/language%20fort>,
        <http://example.org/resource/topic/language%20fort%20shown>,
        <http://example.org/resource/topic/query> ;
    dom:mentionsEntity <http://example.org/resource/entity/FOrT%C2%B4E>,
        <http://example.org/resource/entity/Fig>,
        <http://example.org/resource/entity/Listing%201>,
        <http://example.org/resource/entity/SPARQL> ;
    prov:wasDerivedFrom ex:fort-a-federated-ontology-and-timeseries-query-engine-page-3 .

