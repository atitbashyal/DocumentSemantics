ex:fort-a-federated-ontology-and-timeseries-query-engine-p5-2 a doc:Paragraph ;
    rdfs:label "Page 5 Paragraph 2" ;
    doc:bbox "67.09259796142578,207.330322265625,295.65972900390625,218.08934020996094" ;
