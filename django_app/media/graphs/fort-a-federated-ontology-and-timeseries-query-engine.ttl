ex:fort-a-federated-ontology-and-timeseries-query-engine-p1-1 a doc:Paragraph ;
    rdfs:label "Page 1 Paragraph 1" ;
    doc:bbox "220.75881958007812,158.89259338378906,395.4139099121094,180.9237518310547" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-4 ;
    doc:pageNumber 1 ;
    doc:paragraphOrder 1 ;
    doc:text "Charbel El Kaed, Matthieu Boujonnier Schneider Electric: Digital Services Platform" ;
    dom:hasTopic <http://example.org/resource/topic/charbel>,
        <http://example.org/resource/topic/charbel%20el>,
        <http://example.org/resource/topic/kaed>,
        <http://example.org/resource/topic/kaed%20matthieu>,
        <http://example.org/resource/topic/kaed%20matthieu%20boujonnier> ;
    dom:mentionsEntity <http://example.org/resource/entity/Charbel%20El%20Kaed>,
        <http://example.org/resource/entity/Digital%20Services>,
        <http://example.org/resource/entity/Digital%20Services%20Platform>,
        <http://example.org/resource/entity/Matthieu%20Boujonnier%20Schneider%20Electric> ;
    prov:wasDerivedFrom ex:fort-a-federated-ontology-and-timeseries-query-engine-page-1 .

ex:fort-a-federated-ontology-and-timeseries-query-engine-p1-10 a doc:Paragraph ;
    rdfs:label "Page 1 Paragraph 10" ;
    doc:bbox "313.7600402832031,526.6221313476562,552.2839965820312,604.23388671875" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-4 ;
    doc:pageNumber 1 ;
    doc:paragraphOrder 10 ;
    doc:text "The scope of this work is partially described in [3]. It is applied to our facility in North America whose systems include a Building Management System (BMS) and a Power Monitoring System (PM). Our goal is to connect the two onpremise systems to the cloud and be able to combine their data sources to drive better insights for energy management as outlined in Fig. 1." ;
    dom:hasTopic <http://example.org/resource/topic/insights>,
        <http://example.org/resource/topic/insights%20energy>,
        <http://example.org/resource/topic/insights%20energy%20management>,
        <http://example.org/resource/topic/management>,
        <http://example.org/resource/topic/systems> ;
    dom:mentionsEntity <http://example.org/resource/entity/BMS>,
        <http://example.org/resource/entity/Building%20Management%20System>,
        <http://example.org/resource/entity/Fig>,
        <http://example.org/resource/entity/North%20America>,
        <http://example.org/resource/entity/PM>,
        <http://example.org/resource/entity/Power%20Monitoring%20System>,
        <http://example.org/resource/entity/two> ;
    prov:wasDerivedFrom ex:fort-a-federated-ontology-and-timeseries-query-engine-page-1 .

ex:fort-a-federated-ontology-and-timeseries-query-engine-p1-11 a doc:Paragraph ;
    rdfs:label "Page 1 Paragraph 11" ;
    doc:bbox "57.476318359375,518.1417846679688,296.0000305175781,697.973876953125" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-5 ;
    doc:pageNumber 1 ;
    doc:paragraphOrder 11 ;
    doc:text "In industrial domains, connected things are of heterogeneous types and range from low-end devices such as sensors and actuators to more capable items such as devices, gateways, and systems. Such diversiﬁed connected things embed different resources: CPU, memory, and bandwidth which limit their communication mediums, protocols, and data models. Indeed, the generated information can be abstracted and expressed in data models with human-friendly names such as ’ActiveEnergy-into-the-Load’ or ’Temperature’. However, such naming conventions are human-dependent and syntax-based which lead to inconsistency and incompatibility. For example, a system might expose temperature data as ’Temperature’ while another system will refer to it as ’T.’ or ’Temp’. In addition, units, scales, and precision bring more challenges. Due to the heterogeneity in various data models, data interpretation and analysis has become seriously challenging." ;
    dom:hasTopic <http://example.org/resource/topic/connected%20things>,
        <http://example.org/resource/topic/data>,
        <http://example.org/resource/topic/data%20models>,
        <http://example.org/resource/topic/models>,
        <http://example.org/resource/topic/things> ;
    dom:mentionsEntity <http://example.org/resource/entity/ActiveEnergy>,
        <http://example.org/resource/entity/CPU>,
        <http://example.org/resource/entity/Temp> ;
    prov:wasDerivedFrom ex:fort-a-federated-ontology-and-timeseries-query-engine-page-1 .

ex:fort-a-federated-ontology-and-timeseries-query-engine-p1-12 a doc:Paragraph ;
    rdfs:label "Page 1 Paragraph 12" ;
    doc:bbox "313.7600402832031,699.9344482421875,552.2745971679688,720.757080078125" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-5 ;
    doc:pageNumber 1 ;
    doc:paragraphOrder 12 ;
    doc:text "As mentioned in [3], the cloud agent extracts and publishes to the cloud two types of information : topological and time-" ;
    dom:hasTopic <http://example.org/resource/topic/cloud>,
        <http://example.org/resource/topic/extracts%20publishes>,
        <http://example.org/resource/topic/extracts%20publishes%20cloud>,
        <http://example.org/resource/topic/information%20topological>,
        <http://example.org/resource/topic/information%20topological%20time> ;
    dom:mentionsEntity <http://example.org/resource/entity/two> ;
    prov:wasDerivedFrom ex:fort-a-federated-ontology-and-timeseries-query-engine-page-1 .

ex:fort-a-federated-ontology-and-timeseries-query-engine-p1-13 a doc:Paragraph ;
    rdfs:label "Page 1 Paragraph 13" ;
    doc:bbox "57.476318359375,700.0372314453125,295.9942321777344,720.8599243164062" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-5 ;
    doc:pageNumber 1 ;
    doc:paragraphOrder 13 ;
    doc:text "Semantic Web technology [1] is gaining more popularity over the years. In industrial environments, Semantic Web and" ;
    dom:hasTopic <http://example.org/resource/topic/industrial%20environments>,
        <http://example.org/resource/topic/industrial%20environments%20semantic>,
        <http://example.org/resource/topic/semantic>,
        <http://example.org/resource/topic/semantic%20web>,
        <http://example.org/resource/topic/web> ;
    dom:mentionsEntity <http://example.org/resource/entity/Semantic%20Web>,
        <http://example.org/resource/entity/Semantic%20Web%20and>,
        <http://example.org/resource/entity/the%20years> ;
    prov:wasDerivedFrom ex:fort-a-federated-ontology-and-timeseries-query-engine-page-1 .

