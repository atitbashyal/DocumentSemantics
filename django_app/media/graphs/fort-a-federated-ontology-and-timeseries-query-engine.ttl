ex:fort-a-federated-ontology-and-timeseries-query-engine-p6-5 a doc:Paragraph ;
    rdfs:label "Page 6 Paragraph 5" ;
    doc:bbox "314.0455627441406,163.19322204589844,552.5697021484375,252.16282653808594" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-19 ;
    doc:pageNumber 6 ;
    doc:paragraphOrder 5 ;
    doc:text "In our evaluation of the Virtual Graphs architecture with Virtuoso, the execution time of Q1 on the timeseries table 50m took 3 hours to complete. Therefore, we decided to eliminate Virtuoso from the Virtual Graphs architecture evaluation. Furthermore, while evaluating the All-in-One architecture, we discovered a limitation in the CSV bulk loading feature of Virtuoso preventing it from loading such large data sets. Therefore, the evaluation below involves Stardog only." ;
    dom:hasTopic <http://example.org/resource/topic/architecture>,
        <http://example.org/resource/topic/graphs%20architecture>,
        <http://example.org/resource/topic/loading>,
        <http://example.org/resource/topic/virtual%20graphs%20architecture>,
        <http://example.org/resource/topic/virtuoso> ;
    dom:mentionsEntity <http://example.org/resource/entity/3%20hours>,
        <http://example.org/resource/entity/50>,
        <http://example.org/resource/entity/CSV>,
        <http://example.org/resource/entity/Q1>,
        <http://example.org/resource/entity/Stardog>,
        <http://example.org/resource/entity/Virtual%20Graphs> ;
    prov:wasDerivedFrom ex:fort-a-federated-ontology-and-timeseries-query-engine-page-6 .

ex:fort-a-federated-ontology-and-timeseries-query-engine-p6-6 a doc:Paragraph ;
    rdfs:label "Page 6 Paragraph 6" ;
    doc:bbox "58.15779113769531,232.08726501464844,296.672119140625,286.9833984375" ;
    doc:inSection ex:fort-a-federated-ontology-and-timeseries-query-engine-section-19 ;
    doc:pageNumber 6 ;
    doc:paragraphOrder 6 ;
    doc:text "Sub-query 1 (subq1), shown in Listing 4, contains a ﬁlter on the values. The number of returned records and time performance are expected to vary based on the number of records of the timeseries table. It is a basic test, expected to pass on each of the three architectures." ;
    dom:hasTopic <http://example.org/resource/topic/expected>,
        <http://example.org/resource/topic/expected%20pass>,
        <http://example.org/resource/topic/expected%20pass%20architectures>,
        <http://example.org/resource/topic/number>,
        <http://example.org/resource/topic/records> ;
    dom:mentionsEntity <http://example.org/resource/entity/Listing%204>,
        <http://example.org/resource/entity/three> ;
    prov:wasDerivedFrom ex:fort-a-federated-ontology-and-timeseries-query-engine-page-6 .

